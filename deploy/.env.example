# Copy this file to deploy/.env and replace every CHANGE_ME value with a long, random,
# unique secret before running `docker compose`. deploy/.env is git-ignored - it must never
# be committed. See deploy/README.md for a password-generation example and the full setup
# walkthrough.

# PostgreSQL admin/bootstrap password. Used once, by the "db" container itself and the
# init script, to create the application role below - the application never connects with
# this credential.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD

# Application database. The API and the migration step connect only as this non-superuser
# role, which owns this database.
APP_DB_NAME=literature_millionaire
APP_DB_USER=literature_app
APP_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD

# Host port the "web" (Nginx) container is published on, bound to 127.0.0.1 only. For local
# verification and diagnostics on the server - public traffic uses SHARED_PROXY_NETWORK below.
APP_HTTP_PORT=8080

# Existing Docker network used by the VPS Caddy reverse proxy.
# Production VPS value: attendanceqr_default
SHARED_PROXY_NETWORK=CHANGE_ME_EXISTING_CADDY_NETWORK

# "QRLog ilə davam et": the secret QRLog signs sign-in confirmations with. The same value has to be
# configured on the QRLog side; anyone holding it can claim to be any employee, so treat it like a
# password and generate it with `openssl rand -base64 48`. Leave it empty to keep the feature off -
# confirmations are then refused rather than trusted.
QRLOG_VOUCH_SECRET=

# Where QRLog approves a sign-in from the same phone (docs/qrlog-phone-signin.md). Must contain {code},
# be https and on qrlog.az. Leave empty until QRLog has that page: the phone button is then not shown.
QRLOG_APP_CONFIRM_URL=

# Admin panel: phone numbers allowed to sign in, comma-separated (e.g. 0501234567,+994551234567).
# Empty means nobody can sign in.
ADMIN_PHONES=
